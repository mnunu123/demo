# 전부 선택 사항입니다. 하나도 없으면 템플릿 모드 + HN 실시간 + 나머지 샘플 데이터로 동작합니다.

# --- LLM (둘 중 하나. 둘 다 있으면 Claude 우선) ---
ANTHROPIC_API_KEY=
# 기본값 claude-sonnet-5-5. 비용을 줄이려면 claude-haiku-5-5
ANTHROPIC_MODEL=

# OpenAI 호환 API (OpenAI, OpenRouter, Groq 등). 모델 이름을 꼭 적어야 켜집니다.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# --- 공개 배포 보호 ---
# 설정하면 이 코드를 스튜디오 상단 "접근 코드"에 넣은 사람만 LLM을 씁니다. 나머지는 템플릿 모드.
ACCESS_CODE=
# IP당 10분 동안 LLM 호출 수 (기본 40)
LLM_RATE_LIMIT=

# --- Reddit (승인받은 앱만. https://support.reddithelp.com/hc/en-us/articles/42728983564564) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# 예: web:lurk:0.1 (by /u/내아이디)
REDDIT_USER_AGENT=

# --- X API v2 최근 검색 (종량제: 게시물 읽기 1건 $0.005) ---
X_BEARER_TOKEN=
# 한 번에 가져올 게시물 수 (10~100, 기본 50)
X_MAX_RESULTS=
